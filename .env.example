# Use Supabase project URL and the publishable key (safe for client exposure only because RLS is enabled).
# Never add the Supabase secret/service_role key here or to NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
